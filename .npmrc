# Do not auto-install peer dependencies. In particular this keeps
# electron-builder-squirrel-windows -> electron-winstaller (which vendors
# 7-Zip 16.04, nuget and rcedit executables) out of node_modules; OneLoom
# never builds Squirrel installers. All peers we need are explicit devDependencies.
legacy-peer-deps=true
fund=false
audit=false
